# Database connection
# Copy this file to .env and fill in your values.
DB_HOST=your_host
DB_PORT=your_port
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# JWT: secret must be at least 32 bytes (generate with: openssl rand -base64 48); expiration in minutes.
JWT_SECRET=change-this-secret-to-a-random-value-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# Backups directory
BACKUP_DIR=.local/backup
